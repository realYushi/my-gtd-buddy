# GTD State Template
# Copy this file to state.yaml to get started:
#   cp state.yaml.template state.yaml
#
# Older templates migrate automatically. Their undated trends, patterns, and
# context counts are preserved under legacy_history and never become dated claims.

schema_version: 2

last_session:
  date: null
  mode: null
  items_processed: null
  id: null

last_review:
  date: null
  completed_count: null
  focus: null
  id: null

preferences:
  processing_style: quick

# Undated data from the pre-dated tracking format.
legacy_history:
  trends:
    weekly_completed: []
    weekly_processed: []
    weekly_deferred: []
  contexts:
    home: 0
    office: 0
    errands: 0
    calls: 0
  patterns:
    peak_days: []
    defer_days: []
    avg_process_velocity: 0

# Written by state.sh. Sessions are keyed by stable caller-supplied IDs.
tracking:
  sessions: {}
  completion_snapshots: {}
  identities: {}
  velocity_seed: null
  next_sequence: 1
